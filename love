<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Ты меня любишь?</title>
<style>
  * { box-sizing: border-box; }
  body {
    margin: 0;
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(135deg, #ffb6d5, #ff8fc0);
    font-family: 'Segoe UI', Arial, sans-serif;
    overflow: hidden;
    position: relative;
  }

  .card {
    background: #ffd6e8;
    border-radius: 24px;
    padding: 40px 50px;
    box-shadow: 0 15px 40px rgba(200, 50, 120, 0.35);
    text-align: center;
    max-width: 90vw;
    z-index: 10;
    animation: appear 0.6s ease;
  }

  @keyframes appear {
    from { opacity: 0; transform: scale(0.8); }
    to { opacity: 1; transform: scale(1); }
  }

  h1 {
    color: #c2185b;
    margin: 0 0 30px;
    font-size: 28px;
  }

  .buttons {
    display: flex;
    gap: 20px;
    justify-content: center;
    flex-wrap: wrap;
  }

  button {
    border: none;
    border-radius: 50px;
    padding: 14px 36px;
    font-size: 20px;
    font-weight: bold;
    cursor: pointer;
    transition: transform 0.15s, box-shadow 0.15s;
  }

  #yesBtn {
    background: #e91e63;
    color: white;
    box-shadow: 0 6px 15px rgba(233, 30, 99, 0.5);
  }
  #yesBtn:hover { transform: scale(1.08); }

  #noBtn {
    background: #f8bbd0;
    color: #880e4f;
    position: relative;
  }

  .love-message {
    display: none;
    background: #ffd6e8;
    border-radius: 24px;
    padding: 45px 40px;
    box-shadow: 0 15px 40px rgba(200, 50, 120, 0.35);
    text-align: center;
    max-width: 90vw;
    width: 560px;
    z-index: 10;
    animation: appear 0.7s ease;
  }

  .love-message p {
    color: #c2185b;
    font-size: 20px;
    line-height: 1.6;
    margin: 0;
  }

  .heart {
    position: absolute;
    font-size: 28px;
    animation: floatUp linear infinite;
    pointer-events: none;
    opacity: 0.8;
  }

  @keyframes floatUp {
    from { transform: translateY(0) rotate(0deg); opacity: 0.9; }
    to   { transform: translateY(-110vh) rotate(360deg); opacity: 0; }
  }
</style>
</head>
<body>

  <div class="card" id="questionCard">
    <h1>Ты меня любишь?</h1>
    <div class="buttons">
      <button id="yesBtn">Да</button>
      <button id="noBtn">Нет</button>
    </div>
  </div>

  <div class="love-message" id="loveMessage">
    <p>Солнце, я тебя очень сильно люблю. Каждый день думаю о тебе,
    жду когда встретимся, хочу увидеть тебя, твои глаза, услышать твой голос,
    твои шутки, запах твой даже. Люблю тебя, спасибо за то, что ты есть у меня 💋💋💋</p>
  </div>

<script>
  const noBtn = document.getElementById('noBtn');
  const yesBtn = document.getElementById('yesBtn');
  const questionCard = document.getElementById('questionCard');
  const loveMessage = document.getElementById('loveMessage');

  function moveNo() {
    const padding = 20;
    const maxX = window.innerWidth - noBtn.offsetWidth - padding;
    const maxY = window.innerHeight - noBtn.offsetHeight - padding;

    const x = Math.random() * Math.max(0, maxX);
    const y = Math.random() * Math.max(0, maxY);

    noBtn.style.position = 'fixed';
    noBtn.style.left = x + 'px';
    noBtn.style.top = y + 'px';
  }

  noBtn.addEventListener('mouseover', moveNo);
  noBtn.addEventListener('mousemove', moveNo);
  noBtn.addEventListener('touchstart', (e) => { e.preventDefault(); moveNo(); }, {passive:false});
  noBtn.addEventListener('click', (e) => e.preventDefault());

  yesBtn.addEventListener('click', () => {
    questionCard.style.display = 'none';
    loveMessage.style.display = 'block';
    startHearts();
  });

  function startHearts() {
    setInterval(() => {
      const h = document.createElement('div');
      h.className = 'heart';
      h.textContent = ['❤️','💖','💗','💕','💋'][Math.floor(Math.random()*5)];
      h.style.left = Math.random() * 100 + 'vw';
      h.style.bottom = '-40px';
      const duration = 5 + Math.random() * 5;
      h.style.animationDuration = duration + 's';
      document.body.appendChild(h);
      setTimeout(() => h.remove(), duration * 1000);
    }, 250);
  }
</script>

</body>
</html>
